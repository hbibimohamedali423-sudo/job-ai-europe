{
  "name": "job-ai-europe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @job-ai/web dev",
    "dev:all": "pnpm -r dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @job-ai/web build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @job-ai/web test:unit",
    "test:integration": "pnpm --filter @job-ai/web test:integration",
    "test:e2e": "pnpm --filter @job-ai/web test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @job-ai/web db:migrate",
    "db:seed": "pnpm --filter @job-ai/web db:seed",
    "supabase:functions": "pnpm --filter @job-ai/supabase dev"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
